# ==============================================================================
# FinInsight — Environment Configuration Template
# All secrets must be provided via environment variables in production.
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fininsight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345

# Redis & Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# Kafka Messaging & Event-Driven Architecture
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_CONSUMER_GROUP_ID=fininsight-consumer-group

# Security & JWT Authentication
# JWT Secret must be >= 64 characters (256-bit)
JWT_SECRET=FinInsight_Local_Development_JWT_Secret_Key_2026_At_Least_64_Characters_Long
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Strict

# Cache TTL Configuration (Seconds)
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DASHBOARD_TTL_SECONDS=300
CACHE_ANALYTICS_TTL_SECONDS=600
CACHE_CATEGORIES_TTL_SECONDS=1800
CACHE_AI_INSIGHTS_TTL_SECONDS=600

# AI-Powered Financial Intelligence Layer
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
